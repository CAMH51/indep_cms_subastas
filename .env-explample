# ==========================================================
# Variables de entorno - copiar este archivo como ".env"
# ==========================================================

# Entorno de ejecucion: development | production
NODE_ENV=development
APP_URL=

# Puerto donde correra el servidor Express
PORT=3000

# ----------------------------------------------------------
# Base de datos PostgreSQL
# ----------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_DIALECT=postgres


#Active Directory
URL_AD='ldap://indep.gob.mx'
BASEDN_AD='DC=indep,DC=gob,DC=mx'
ACTIVE_DIRECTORY= true

#configuración SQLSERVER


SQL_SERVER_DB=
SQL_SERVER_USER=
SQL_SERVER_PASS=
SQL_SERVER_HOST=
SQL_SERVER_PORT=
#SQL_SERVER_HOST=

# ----------------------------------------------------------
# JSON Web Tokens
# ----------------------------------------------------------
# Usar cadenas largas y aleatorias en produccion (openssl rand -hex 64)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Duracion del token de acceso (corto) y del token de refresco (sesion)
JWT_ACCESS_EXPIRES_IN=10m
JWT_REFRESH_EXPIRES_IN=8h

# ----------------------------------------------------------
# Seguridad de cookies / CORS
# ----------------------------------------------------------
# Dominio(s) permitido(s) para CORS, separados por coma
CORS_ORIGIN=

# En produccion con HTTPS debe ser "true" para cookies "secure"
COOKIE_SECURE=false

# Clave usada para firmar el token CSRF
CSRF_SECRET=

