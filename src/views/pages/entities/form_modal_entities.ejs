<form id="form_campo" novalidate>
    <div class="grid grid-cols-2 gap-4">
        <%- include('../../components/input.ejs',{
            label:"Nombre del campo: *",
            id:"nombre_campo",
            name:"nombre_campo",
            type:"text",
            placeholder:"Ingresa el nombre del campo.",
            pattern:"[a-z][a-z0-9_]{0,49}",
            required:true
        }) %>

        <%- include('../../components/input.ejs',{
            label:"Etiqueta del campo: *",
            id:"etiqueta_campo",
            name:"etiqueta_campo",
            type:"text",
            placeholder:"Ingrese la etiqueta que se mostrara en el campo",
            pattern:"",
            required:true
        }) %>
    
        <%- include('../../components/select.ejs',{
            label:"Tipo de dato: *",
            id:"tipo_campo",
            name:"tipo_campo",
            label_option:"Seleccione un tipo de dato",
            data:[
                {id_tipo:"string",  name:"Texto"},
                {id_tipo:"integer", name:"Numero Entero"},
                {id_tipo:"bigint",  name:"Numero Grande"},
                {id_tipo:"decimal", name:"Numero Decimal"},
                {id_tipo:"boolean", name:"Valor Booleano (true/false)"},
                {id_tipo:"date",    name:"Date (fecha y hora)"},
                {id_tipo:"dateonly",name:"Dateonly (solo fecha)"},
                {id_tipo:"file",name:"File (archivo)"},
            ],
            id_data:"id_tipo",
            name_data:"name",
            required:true
        }) %>
    </div>

    <div class="grid grid-cols-2 gap-4">
         <%- include('../../components/input.ejs',{
            label:"Tamaño del campo (Max 255): *",
            id:"tamanio_campo",
            name:"tamanio_campo",
            type:"number",
            className:"tamanio_campo",
            placeholder:"Tamaño del campo (Max 255).",
            required:false,
            disabled:true
        }) %>

        <%- include('../../components/input.ejs',{
            label:"Número de decimales: *",
            id:"decimal_campo",
            name:"decimal_campo",
            className:"decimal_campo",
            type:"number",
            placeholder:"0.00",
            required:false,
            disabled:true
        }) %>
    </div>
<!--         <div class="opciones" id="opciones">
            
        </div> -->
    
        <h3 class="text-md font-semibold">Opciones</h3>
    <div class="grid grid-cols-3 gap-4">
        <%- include('../../components/checkbox.ejs',{
            label:"Unique",
            id:"unique",
            name: "unique",
            value: "1"
        }) %>
    
        <%- include('../../components/checkbox.ejs',{
            label:"Null",
            id:"nullable",
            name: "nullable",
            value: "1"
        }) %>
        
        <%- include('../../components/checkbox.ejs',{
            label:"Requerido",
            id:"requerido",
            name: "requerido",
            value: "1"
        }) %>
    </div>
    
        <%- include('../../components/input.ejs',{
            label:"Valor por defecto:",
            id:"default_campo",
            name:"default_campo",
            type:"text",
            placeholder:"Ingresa el valor por defecto del campo.",
        }) %>
    
        <div>
            <%- include('../../components/button.ejs',{
                type:"button",
                title:"Agregar Campo",
                label:"Agregar",
                id:"btn_agregar_campo",
                icon:"<i class='bi bi-plus-circle'></i>",
                bg:"bg-[#611323]",
                bg_hover:"hover:bg-[#9b2247]",
                bg_text:"text-[#ffffff]"
            }) %>
        </div>
    </div>

</form>


<template id="field_string">
    <%- include('../../components/input.ejs',{
        label:"Tamaño del campo (Max 255): *",
        id:"tamanio_campo",
        name:"tamanio_campo",
        type:"number",
        className:"tamanio_campo",
        placeholder:"Tamaño del campo (Max 255).",
        required:true
    }) %>
</template>

<template id="field_decimal">
    <%- include('../../components/input.ejs',{
        label:"Número de decimales: *",
        id:"decimal_campo",
        name:"decimal_campo",
        className:"decimal_campo",
        type:"number",
        placeholder:"0.00",
        required:true
    }) %>
</template>

<script type="module" nonce="<%= nonce %>">
    import { selectTipoDato, getDataField } from '/js/entities.js';

    import {table} from '/js/table.js';
    import { validateAll} from '/js/validateForm.js';
    let items = [];

    const container = document.getElementById('fields');
    const form = document.getElementById('form_campo');
    const type = document.getElementById('tipo_campo');
    selectTipoDato('tipo_campo', 'opciones');

    let validarCampo = [
        {name:'nombre_campo',validate:'required'},
        {name:'tipo_campo',validate:'required'},
        {name:'etiqueta_campo',validate:'required'},
    ]


    console.log('validarCampo',validarCampo);


    document.getElementById('btn_agregar_campo').addEventListener('click', function(e) {
        e.preventDefault();
        if(type.value === 'string'){
            validarCampo.push(
                {name:'tamanio_campo', validate:'required'}
            )
        }

        if(type.value === 'decimal'){
            validarCampo.push(
                {name:'decimal_campo', validate:'required'}
            )
        }
        const {valid} = validateAll(validarCampo);
        if(valid){
            const data = getDataField();
            items.push(data);
            
            table([
                "Nombre del campo",
                "Etiqueta del campo",
                "Tipo de dato",
                "Tamaño del campo",
                "Número de decimales",
                "Unique",
                "Nullable",
                "Requerido",
                "Valor por defecto",
                "Acciones"
            ], items, container);
        
            limpiar();
        }
    });

    function limpiar(){
        document.getElementById('nombre_campo').value = "";
        document.getElementById('etiqueta_campo').value = "";
    }

</script>