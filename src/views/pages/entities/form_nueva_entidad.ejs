
<%- include('../../components/breadcrumb.ejs',{
    links:[
        {url:"/entities/new", name:'Nueva libreria'}
    ]
}) %>
<h4 class="text-2xl font-semibold mb-7">Nueva Libreria</h4>

<% if(error) {%> <%= error%> <%}%>

<form method="POST" action="/entities" class="flex flex-col flex-1 min-h-0">
    <%- include('../../components/input.ejs',{
        label:"Nombre de la libreria (solo usar minúsculas, números y guión bajo( _ )):",
        id:"name",
        name:"name",
        type:"text",
        placeholder:"ej. sliders",
        pattern:"[a-z][a-z0-9_]{0,49}",
        required:true

    }) %>

    <div class="flex justify-between">
        <h3 class="text-xl font-semibold">Campos requeridos:</h3>
        <div class="flex gap-2">
            <%- include('../../components/button.ejs',{
                type:"button",
                title:"Agregar Campo",
                label:"Agregar Campo",
                id:"btn_agregar_campo",
                icon:"<i class='bi bi-plus-circle'></i>",
                bg:"bg-[#002f2a]",
                bg_hover:"hover:bg-[#1e5b4f]",
                bg_text:"text-[#ffffff]"
            }) %>

            <button data-modal-target="default-modal" data-modal-toggle="default-modal" class="text-white bg-brand box-border border border-transparent hover:bg-brand-strong focus:ring-4 focus:ring-brand-medium shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-2.5 focus:outline-none" type="button">
                Agregar campos
            </button> 

            <%- include('../../components/button.ejs',{
                type:"submit",
                title:"Crear libreria",
                label:"Crear Libreria",
                id:"btn_crear_libreria",
                icon:"<i class='bi bi-floppy'></i>",
                bg:"bg-[#611323]",
                bg_hover:"hover:bg-[#9b2247]",
                bg_text:"text-[#ffffff]"
            }) %>
        </div>
    </div>
    <hr class="h-px my-2 bg-neutral-quaternary border-0">

    <div id="fields" class="overflow-y-auto flex-1 min-h-0"></div>


</form>


    <%- include('../../components/modal.ejs',{
        id:"default-modal",
        title:"Agregar Campos",
        body:"../pages/entities/form_modal_entities.ejs"
    }) %>
<template id="field_template">
    <div class="grid grid-cols-6 items-center gap-3 row">
        <%- include('../../components/input.ejs',{
            label:"",
            id:"__ID__name",
            name:"fields[__IDX__][name]",
            type:"text",
            placeholder:"Ingresa el nombre del campo.",
            pattern:"[a-z][a-z0-9_]{0,49}",
            required:true
        }) %>

        <%- include('../../components/select.ejs',{
            label:"",
            id:"__ID__tipo",
            name:"fields[__IDX__][type]",
            label_option:"Seleccione un tipo de dato",
            data:[
                {id_tipo:"string",  name:"String"},
                {id_tipo:"text",    name:"Text"},
                {id_tipo:"integer", name:"Integer"},
                {id_tipo:"bigint",  name:"Bigint"},
                {id_tipo:"decimal", name:"Decimal"},
                {id_tipo:"boolean", name:"Boolean"},
                {id_tipo:"date",    name:"Date (fecha y hora)"},
                {id_tipo:"dateonly",name:"Dateonly (solo fecha)"}
            ],
            id_data:"id_tipo",
            name_data:"name"
        }) %>

        <%- include('../../components/input.ejs',{
            label:"",
            id:"__ID__length",
            name:"fields[__IDX__][length]",
            type:"number",
            placeholder:"Tamaño del campo (Max 255).",
        }) %>

        <%- include('../../components/input.ejs',{
            label:"",
            id:"__ID__scale",
            name:"fields[__IDX__][scale]",
            type:"number",
            placeholder:"Decimal del campo.",
        }) %>

        <%- include('../../components/checkbox.ejs',{
            label:"Obligatorio",
            id:"__ID__required",
            name: "fields[__IDX__][required]",
            value: "1"
        }) %>

        <%- include('../../components/button.ejs',{
            type:"button",
            title:"Eliminar",
            label:"",
            id:"__ID__remove",
            icon:"<i class='bi bi-trash3'></i>",
            bg:"bg-[#611323]",
            bg_hover:"hover:bg-[#9b2247]",
            bg_text:"text-[#ffffff]"
        }) %>

    </div>
</template>

<script type="module" nonce="<%= nonce %>">
import {addField} from '/js/add_field.js';
let i = 0;
const container = document.getElementById('fields');
const template = document.getElementById('field_template');

document.getElementById('btn_agregar_campo').addEventListener('click', ()=>{
    i = addField(container, template, i);
    
});
</script>

