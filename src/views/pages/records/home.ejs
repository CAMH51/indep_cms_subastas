
    <h3 class="text-2xl font-bold mb-4">Libreria: <%= entity.name %></h3>

    <% if (error) { %><p class="error"><%= error %></p><% } %>

    <form method="POST" action="/entities/<%= entity.name %>/records">
        <% entity.fields.forEach(f => {%> 
            <% if(f.type === 'string'){%>
                <%- include('../../components/input.ejs',{
                    label:f.name + ":",
                    id:f.name,
                    name:f.name,
                    type:"text",
                    placeholder:"",
                    required:f.required ? true : false
                }) %>    
            <%}%>
        <%})%>
    </form>
